{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "1.0.4",
  "identifier": "dev.nova.social",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 1480,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNTNENDgyREQ5NDcwMEEKUldRS2NKVGRndFJULzZadGtHaEZ2dU5pMTZMVnhLdHhLL1ZtdlNDaXNuOHpqYjZuYWc0U200dkcK",
      "endpoints": [
        "https://github.com/jayton123456789-hub/NOVA-DISCORD-REPLACEMENT/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
