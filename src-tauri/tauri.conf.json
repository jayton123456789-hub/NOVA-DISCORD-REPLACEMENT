{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "1.0.1",
  "identifier": "dev.nova.social",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "NOVA",
      "width": 1480,
      "height": 900,
      "minWidth": 900,
      "minHeight": 620,
      "resizable": true,
      "decorations": false,
      "transparent": false,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
